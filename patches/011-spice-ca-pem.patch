diff --git a/src/protocols/spice/auth.c b/src/protocols/spice/auth.c
index ac89c90a..f381f875 100644
--- a/src/protocols/spice/auth.c
+++ b/src/protocols/spice/auth.c
@@ -51,9 +51,20 @@ void guac_spice_session_configure(guac_client* client, SpiceSession* session) {
 
         g_object_set(session, "tls-port", settings->tls_port, NULL);
 
-        /* Provide CA certificate for verification, if given */
-        if (settings->ca_file != NULL)
-            g_object_set(session, "ca-file", settings->ca_file, NULL);
+        /* Provide CA certificate for verification, if given. PEM data is
+         * passed in memory through the "ca" property; anything else is
+         * treated as the path to a CA file. */
+        if (settings->ca_cert != NULL) {
+            if (strstr(settings->ca_cert, "-----BEGIN ") != NULL) {
+                GByteArray* ca = g_byte_array_new();
+                g_byte_array_append(ca, (const guint8*) settings->ca_cert,
+                        strlen(settings->ca_cert));
+                g_object_set(session, "ca", ca, NULL);
+                g_byte_array_unref(ca);
+            }
+            else
+                g_object_set(session, "ca-file", settings->ca_cert, NULL);
+        }
 
         /* Provide expected certificate subject, if given */
         if (settings->cert_subject != NULL)
